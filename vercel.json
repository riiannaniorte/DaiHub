:root {
    --bg: #121212;
    --bg-soft: #1c1b1b;
    --bg-alt: #202020;
    --text: #e0e0e0;
    --text-soft: #bbbbbb;
    --muted: #888;
    --border: rgba(255, 255, 255, 0.08);
    --accent: #e50914;
    --accent-strong: #ff3b46;
    --shadow: 0 18px 35px rgba(0, 0, 0, 0.35);
    --container: 1200px;
    --radius: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
}

.skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--accent);
    color: #fff;
    padding: 10px 16px;
    z-index: 10000;
    border-radius: 0 0 8px 8px;
}

.skip-link:focus {
    left: 16px;
}

.page-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: rgba(28, 27, 27, 0.96);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(8px);
}

.page-header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.page-header h1 a {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: clamp(1.2rem, 1.5vw, 1.6rem);
    font-weight: 700;
}

.page-header h1 img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
}

.main-menu ul {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
}

.main-menu a {
    color: var(--text-soft);
    font-size: 0.96rem;
    transition: color 0.2s ease;
}

.main-menu a:hover,
.main-menu a:focus-visible {
    color: var(--accent-strong);
}

.user-menu-item {
    position: relative;
}

.user-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: none;
    min-width: 180px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    list-style: none;
    box-shadow: var(--shadow);
    z-index: 100;
    overflow: hidden;
}

.user-menu-item:hover .user-dropdown,
.user-menu-item:focus-within .user-dropdown {
    display: block;
}

.user-dropdown li a {
    display: block;
    padding: 10px 14px;
    color: var(--text-soft);
    white-space: nowrap;
}

.user-dropdown li a:hover,
.user-dropdown li a:focus-visible {
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
}

.logout-separator {
    border-top: 1px solid var(--border);
}

.h3 {
    max-width: var(--container);
    margin: 30px auto 20px;
    padding: 0 20px;
    color: #fff;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    border-left: 4px solid var(--accent);
    padding-left: 12px;
}

.anime-list {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 20px 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
}

.anime-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
}

.anime-card:hover {
    transform: translateY(-4px);
    border-color: rgba(229, 9, 20, 0.8);
    box-shadow: 0 15px 28px rgba(0, 0, 0, 0.22);
}

.anime-img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    background: #2b2b2b;
}

.anime-title {
    color: #fff;
    font-size: 1rem;
    padding: 12px 12px 4px;
}

.anime-genre {
    color: var(--muted);
    font-size: 0.82rem;
    padding: 0 12px 15px;
}

footer {
    margin-top: 48px;
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    color: var(--muted);
    text-align: center;
    padding: 40px 20px;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 14px;
}

.social-links a {
    color: #aaa;
    font-size: 1.2rem;
    transition: color 0.2s ease, transform 0.2s ease;
}

.social-links a:hover,
.social-links a:focus-visible {
    color: var(--accent-strong);
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .page-header-inner {
        flex-direction: column;
        align-items: flex-start;
    }

    .main-menu {
        width: 100%;
    }

    .main-menu ul {
        justify-content: flex-start;
    }

    .anime-list {
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    }
}

@media (max-width: 480px) {
    .page-header-inner {
        padding: 12px 16px;
    }

    .main-menu ul {
        gap: 10px 14px;
    }

    .h3,
    .anime-list {
        padding-left: 16px;
        padding-right: 16px;
    }
}
